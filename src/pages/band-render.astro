---
// The render target for scripts/bands.mjs. Deliberately bare: no Layout, no fonts, no chrome —
// just a canvas running one Sketch at a pinned size, so the capture is the Band and nothing else.
//
// It lives in src/pages so Astro bundles the Sketch modules for it, and scripts/bands.mjs deletes
// it from dist once the Bands are rendered, so it never ships. It cannot be named with a leading
// underscore: Astro treats that as "ignore", which excludes it from the build as well as the route
// table, leaving the renderer with nothing to load.
import { sketches } from '../bands';
import { P5_SRC, P5_INTEGRITY } from '../bands/cdn';
import { ACCENT } from '../theme';

const names = Object.keys(sketches);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>band render target</title>
		<meta name="robots" content="noindex" />
		{/* A Sketch may read --accent (trails does). Without it this bare page resolves the token to
		    nothing, the Sketch falls back to a literal, and every Band keeps shipping in the old
		    colour after a re-theme with no error to notice it by. */}
		<style is:inline set:html={`:root{--accent:${ACCENT}}`}></style>
		<style>
			html,
			body {
				margin: 0;
				background: #0a0c10;
				overflow: hidden;
			}
		</style>
	</head>
	<body>
		<div id="band" data-sketches={names.join(',')}></div>

		<script is:inline src={P5_SRC} integrity={P5_INTEGRITY} crossorigin="anonymous"></script>
		<script>
			import { mountBand } from '../bands/harness';
			import { sketches } from '../bands';

			const params = new URLSearchParams(location.search);
			const host = document.getElementById('band')!;
			const sketch = sketches[params.get('sketch') ?? ''];

			// `|| 1` would turn a seed of 0 into 1, and the schema allows any integer — so a post
			// written with `seed: 0` would ship a Band the dev picker never showed. That divergence
			// between preview and shipped image is the one thing this page exists to prevent.
			// Width and height keep `||`: unlike a seed, zero is not a size anyone meant.
			const rawSeed = params.get('seed');
			const seed = rawSeed && Number.isInteger(Number(rawSeed)) ? Number(rawSeed) : 1;

			if (!sketch) {
				// Fail loudly: a silent blank canvas here would be captured and shipped as a Band.
				window.__bandError = `unknown sketch: ${params.get('sketch')}`;
			} else {
				mountBand(sketch, {
					host,
					height: Number(params.get('h')) || 240,
					width: Number(params.get('w')) || 1280,
					seed
				});
			}
		</script>
	</body>
</html>
