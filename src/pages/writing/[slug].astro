---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, subtitle, date, substack } = post.data;
const { Content } = await render(post);
const day = date.toISOString().slice(0, 10);

// Most posts have no subtitle, so fall back to the opening paragraph, markdown stripped.
// Code fences go first: a blank line inside one would otherwise split it into "paragraphs".
const opening =
	post.body
		?.replace(/```[\s\S]*?```/g, '')
		.split('\n\n')
		.find((block) => /^[\p{L}"“‘]/u.test(block)) ?? title;
const plain = opening.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[*_`]/g, '');
const description = subtitle ?? (plain.length > 160 ? `${plain.slice(0, 157)}…` : plain);
---

<Layout title={`${title} — Nathan Arthur`} description={description}>
	<p class="mb-10 font-mono text-xs uppercase tracking-widest text-faint">
		<a href="/writing">&larr; Writing</a>
	</p>

	<h1 class="text-4xl font-medium tracking-tight">{title}</h1>
	{subtitle && <p class="mt-3 text-lg leading-relaxed text-mute">{subtitle}</p>}
	<p class="mt-4 font-mono text-xs text-faint">
		<time datetime={day}>{day}</time> · <a href={substack}>Originally on Substack</a>
	</p>

	<article class="post mt-12">
		<Content />
	</article>
</Layout>

<style>
	/* Markdown output carries no classes, so the post body is styled here, from the palette
	   tokens via theme(). ponytail: hand-rolled instead of @tailwindcss/typography, which
	   would be a plugin plus a theme override to reach the same six colours. */
	.post {
		color: theme('colors.ink');
		line-height: 1.75;
	}
	.post > :global(* + *) {
		margin-top: 1.25em;
	}
	.post :global(:is(h2, h3, h4, h5, h6)) {
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}
	.post > :global(:is(h2, h3, h4, h5, h6)) {
		margin-top: 2.25em;
	}
	.post :global(h2) {
		font-size: 1.5rem;
	}
	.post :global(h3) {
		font-size: 1.25rem;
	}
	.post :global(strong) {
		font-weight: 500;
	}
	.post :global(a) {
		text-decoration: underline;
		text-decoration-color: theme('colors.rule');
		text-underline-offset: 0.25em;
	}
	.post :global(a:hover) {
		text-decoration-color: var(--accent);
	}
	.post :global(ul) {
		list-style: disc;
		padding-left: 1.5em;
	}
	.post :global(ol) {
		list-style: decimal;
		padding-left: 1.5em;
	}
	.post :global(li + li),
	.post :global(li > :is(ul, ol)) {
		margin-top: 0.5em;
	}
	.post :global(li::marker) {
		color: theme('colors.faint');
	}
	.post :global(blockquote) {
		border-left: 2px solid theme('colors.rule');
		padding-left: 1em;
		color: theme('colors.mute');
	}
	.post :global(code) {
		font-family: theme('fontFamily.mono');
		font-size: 0.875em;
	}
	.post :global(pre) {
		overflow-x: auto;
		border: 1px solid theme('colors.rule');
		padding: 1em;
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.post :global(hr) {
		border-top: 1px solid theme('colors.rule');
		margin-block: 3em;
	}
	.post :global(figure img) {
		border: 1px solid theme('colors.rule');
	}
	.post :global(figcaption) {
		margin-top: 0.75em;
		font-family: theme('fontFamily.mono');
		font-size: 0.75rem;
		line-height: 1.5;
		color: theme('colors.faint');
	}
	.post :global(iframe) {
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 1px solid theme('colors.rule');
	}
</style>
