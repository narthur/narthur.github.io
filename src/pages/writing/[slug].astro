---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Band from '../../layouts/Band.astro';

export async function getStaticPaths() {
	// Newest first, as /writing and the home page list them, so index+1 is the older neighbour.
	const posts = (await getCollection('posts')).sort(
		(a, b) => b.data.date.getTime() - a.data.date.getTime()
	);
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] }
	}));
}

const { post, newer, older } = Astro.props;
const { title, subtitle, date, substack, ai, band } = post.data;
const { Content } = await render(post);
const day = date.toISOString().slice(0, 10);

// Most posts have no subtitle, so fall back to the opening paragraph, markdown stripped.
// Code fences go first: a blank line inside one would otherwise split it into "paragraphs".
const opening =
	post.body
		?.replace(/```[\s\S]*?```/g, '')
		.split('\n\n')
		.find((block) => /^[\p{L}"“‘]/u.test(block)) ?? title;
const plain = opening.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[*_`]/g, '');
const description = subtitle ?? (plain.length > 160 ? `${plain.slice(0, 157)}…` : plain);
---

<Layout title={`${title} — Nathan Arthur`} description={description} ai={ai}>
	<p class="mb-10 font-mono text-xs uppercase tracking-widest text-faint">
		<a href="/writing">&larr; Writing</a>
	</p>

	{/* With a band the heading sits bottom-aligned inside its height, and the CSS at the foot of
	    this file cuts a rectangle of page background out from behind `data-band-text`. Without one
	    the wrapper is inert and the heading flows exactly as it always has. */}
	<div class:list={['relative', band && 'flex min-h-[15rem] flex-col justify-end']}>
		{/* Dev runs the Sketch live so the picker can drive it; the shipped page gets the image
		    scripts/bands.mjs rendered, as a background rather than an <img> so it can repeat-x. The
		    field is a torus, so one asset tiles seamlessly at any viewport width — and the height is
		    locked, so the reflection edges at top and bottom are never cropped away. */}
		{band &&
			(import.meta.env.DEV ? (
				<Band sketch={band.sketch} seed={band.seed} />
			) : (
				<div
					aria-hidden="true"
					class="absolute bottom-0 left-1/2 z-0 h-60 w-screen -translate-x-1/2 bg-center bg-repeat-x"
					style={`background-image:url(/writing/${post.id}/band.webp);background-size:auto 240px`}
				/>
			))}

		{/* `w-fit` keeps the backdrop the width of the title rather than the whole column; fit-content
		    still caps at the available width, so a long title wraps as it would. */}
		<div data-band-text class:list={[band && 'relative z-10 w-fit']}>
			<h1 class="text-4xl font-medium tracking-tight">{title}</h1>
			{subtitle && <p class="mt-3 text-lg leading-relaxed text-mute">{subtitle}</p>}
			<p class="mt-4 font-mono text-xs text-faint">
				<time datetime={day}>{day}</time>
				{substack && (
					<>
						{' '}
						· <a href={substack}>Originally on Substack</a>
					</>
				)}
			</p>
		</div>
	</div>

	<article class="post mt-12">
		<Content />
	</article>

	{/* Older on the left, newer on the right, so the pair reads as the timeline does. Each side
	    keeps its column when the other is missing, so the first and last posts don't shift. */}
	{(older || newer) && (
		<nav
			aria-label="More posts"
			class="mt-20 grid gap-x-8 gap-y-6 border-t border-rule pt-8 sm:grid-cols-2"
		>
			{older && (
				<a href={`/writing/${older.id}`} class="block">
					<span class="font-mono text-xs uppercase tracking-widest text-faint">
						&larr; Previous
					</span>
					<span class="mt-1.5 block text-ink">{older.data.title}</span>
				</a>
			)}
			{newer && (
				<a href={`/writing/${newer.id}`} class="block sm:col-start-2 sm:text-right">
					<span class="font-mono text-xs uppercase tracking-widest text-faint">Next &rarr;</span>
					<span class="mt-1.5 block text-ink">{newer.data.title}</span>
				</a>
			)}
		</nav>
	)}

	{/* Comments are GitHub Discussions, via giscus. `specific` + the slug as the term keys each
	    thread to the post rather than to its path, so moving a URL doesn't orphan the thread.
	    `transparent_dark` lets the page background show through instead of laying a panel on it. */}
	<section class="mt-20 border-t border-rule pt-8">
		<h2 class="mb-8 font-mono text-xs uppercase tracking-widest text-faint">Comments</h2>
		<script
			is:inline
			src="https://giscus.app/client.js"
			data-repo="narthur/narthur.github.io"
			data-repo-id="MDEwOlJlcG9zaXRvcnk1NDY3MTM3Ng=="
			data-category="Announcements"
			data-category-id="DIC_kwDOA0I4EM4DGBYy"
			data-mapping="specific"
			data-term={post.id}
			data-strict="1"
			data-reactions-enabled="1"
			data-emit-metadata="0"
			data-input-position="top"
			data-theme="transparent_dark"
			data-lang="en"
			data-loading="lazy"
			crossorigin="anonymous"
			async
		></script>
		<noscript>
			<p class="text-mute">
				Comments need JavaScript. They also live on{' '}
				<a href="https://github.com/narthur/narthur.github.io/discussions">GitHub Discussions</a>,
				which works without it.
			</p>
		</noscript>
	</section>
</Layout>

<script>
	// Interactive embeds are written in posts as a linked still image, which is all the feed and
	// the email get, since both strip iframes. On the site, swap each for the live page it links to.
	for (const a of document.querySelectorAll<HTMLAnchorElement>('.post a[data-embed]')) {
		const frame = document.createElement('iframe');
		frame.src = a.href;
		frame.title = a.querySelector('img')?.alt ?? '';
		frame.loading = 'lazy';

		// The still image was itself the way out to the full page; swapping it for an iframe would
		// take that away, and an embed in a column this narrow is the one that most wants it.
		const caption = document.createElement('figcaption');
		const link = document.createElement('a');
		link.href = a.href;
		link.textContent = 'Open it full screen →';
		caption.append(link);

		a.replaceWith(frame, caption);
	}
</script>

<style>
	/* The heading sits in a hole cut out of the Band: a flat rectangle of page background, hard
	   edged, so the field reads as stopping at a clean boundary rather than fading out behind the
	   text. Pure CSS, so it tracks the real text box at any width — which a knock-out baked into a
	   pre-rendered image could not. `z-10` on the heading puts it in its own stacking context, so
	   `z-index: -1` here lands above the canvas (`z-0`) rather than behind the page. */
	[data-band-text].z-10::before {
		content: '';
		position: absolute;
		inset: -1.25rem -1.5rem -1.5rem;
		z-index: -1;
		background: theme('colors.bg');
	}

	/* Markdown output carries no classes, so the post body is styled here, from the palette
	   tokens via theme(). ponytail: hand-rolled instead of @tailwindcss/typography, which
	   would be a plugin plus a theme override to reach the same six colours. */
	.post {
		color: theme('colors.ink');
		line-height: 1.75;
	}
	.post > :global(* + *) {
		margin-top: 1.25em;
	}
	.post :global(:is(h2, h3, h4, h5, h6)) {
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}
	.post > :global(:is(h2, h3, h4, h5, h6)) {
		margin-top: 2.25em;
	}
	.post :global(h2) {
		font-size: 1.5rem;
	}
	.post :global(h3) {
		font-size: 1.25rem;
	}
	.post :global(strong) {
		font-weight: 500;
	}
	/* Underlined in mute, not rule: a rule-coloured underline is all but invisible against the
	   background, so a link in a paragraph read as plain text until you hovered it. */
	.post :global(a) {
		text-decoration: underline;
		text-decoration-color: theme('colors.mute');
		text-underline-offset: 0.25em;
	}
	.post :global(a:hover) {
		text-decoration-color: var(--accent);
	}
	.post :global(ul) {
		list-style: disc;
		padding-left: 1.5em;
	}
	.post :global(ol) {
		list-style: decimal;
		padding-left: 1.5em;
	}
	.post :global(li + li),
	.post :global(li > :is(ul, ol)) {
		margin-top: 0.5em;
	}
	.post :global(li::marker) {
		color: theme('colors.faint');
	}
	.post :global(blockquote) {
		border-left: 2px solid theme('colors.rule');
		padding-left: 1em;
		color: theme('colors.mute');
	}
	.post :global(code) {
		font-family: theme('fontFamily.mono');
		font-size: 0.875em;
	}
	/* Shiki writes its theme's panel colour into the element's style attribute, so dropping it
	   back to the page background takes !important. The hairline border frames the block, as it
	   does every other framed element here. */
	.post :global(pre) {
		overflow-x: auto;
		border: 1px solid theme('colors.rule');
		padding: 1em;
		font-size: 0.875rem;
		line-height: 1.6;
		background: transparent !important;
	}
	.post :global(hr) {
		border-top: 1px solid theme('colors.rule');
		margin-block: 3em;
	}
	.post :global(figure img) {
		border: 1px solid theme('colors.rule');
	}
	.post :global(figcaption) {
		margin-top: 0.75em;
		font-family: theme('fontFamily.mono');
		font-size: 0.75rem;
		line-height: 1.5;
		color: theme('colors.faint');
	}
	.post :global(iframe) {
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 1px solid theme('colors.rule');
	}
</style>
