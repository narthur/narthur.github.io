---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Subscribe from '../layouts/Subscribe.astro';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout
	title="Writing — Nathan Arthur"
	description="Nathan Arthur's writing across his newsletter and the web"
>
	<p class="mb-10 font-mono text-xs uppercase tracking-widest text-faint">
		<a href="/">&larr; Nathan Arthur</a>
	</p>

	<h1 class="text-4xl font-medium tracking-tight">Writing</h1>
	<p class="mt-5 max-w-prose leading-relaxed text-mute">
		I write about web development, productivity, and AI in my mostly-weekly newsletter. Subscribe
		below, or via{' '}
		<a href="/rss.xml" class="text-ink underline decoration-mute underline-offset-[0.25em]">
			the RSS feed
		</a>
		.
	</p>
	<p class="mt-4 text-sm text-mute">
		Elsewhere:{' '}
		<a
			href="https://blog.beeminder.com/authors/Nathan%20Arthur"
			class="text-ink underline decoration-mute underline-offset-[0.25em]"
		>
			Beeminder blog
		</a>{' '}
		&middot;{' '}
		<a
			href="https://stackoverflow.com/users/narthur"
			class="text-ink underline decoration-mute underline-offset-[0.25em]"
		>
			Stack Overflow
		</a>
	</p>

	<div class="mt-8">
		<Subscribe blurb={false} />
	</div>

	<section class="mt-20">
		<h2 class="font-mono text-xs uppercase tracking-[0.2em] text-faint">Newsletter</h2>
		<ul class="mt-8 border-t border-rule">
			{posts.map((post) => (
				<li class="flex items-baseline justify-between gap-4 border-b border-rule py-3">
					<a href={`/writing/${post.id}`} class="text-sm">
						{post.data.title}
					</a>
					<time
						datetime={post.data.date.toISOString().slice(0, 10)}
						class="whitespace-nowrap font-mono text-xs text-faint"
					>
						{post.data.date.toISOString().slice(0, 10)}
					</time>
				</li>
			))}
		</ul>
	</section>
</Layout>
