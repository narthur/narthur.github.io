---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const beeminderPosts = [
	{
		title: 'Ex WordPress Ad Astro Per Narthurius',
		url: 'https://blog.beeminder.com/astroblog/',
		date: '2023-09-06',
		blurb: 'Announcing the rebuild of the Beeminder blog I did, moving it from WordPress to Astro.'
	},
	{
		title: 'Beeminder vs CBT',
		url: 'https://blog.beeminder.com/cbt/',
		date: '2022-09-15',
		blurb:
			'Responding to the critique of Beeminder that it is a crutch and should be replaced by something positive like CBT.'
	},
	{
		title: 'Announcing TaskRatchet: Like Beeminder for Your Todo List',
		url: 'https://blog.beeminder.com/taskratchet/',
		date: '2020-06-22',
		blurb: 'The announcement post for TaskRatchet.'
	}
];
---

<Layout
	title="Writing — Nathan Arthur"
	description="Narthur Online, Nathan Arthur's mostly-weekly newsletter, plus articles on the Beeminder blog."
>
	<p class="mb-10 font-mono text-xs uppercase tracking-widest text-faint">
		<a href="/">&larr; Nathan Arthur</a>
	</p>

	<h1 class="text-4xl font-medium tracking-tight">Writing</h1>
	<p class="mt-5 max-w-prose leading-relaxed text-mute">
		I write about web development, productivity, and AI in my weekly newsletter. Subscribe in the
		footer, or via{' '}
		<a href="/rss.xml" class="text-ink underline decoration-rule underline-offset-4">
			this RSS feed
		</a>
		.
	</p>

	<section class="mt-20">
		<h2 class="font-mono text-xs uppercase tracking-[0.2em] text-faint">Newsletter</h2>
		<ul class="mt-8 border-t border-rule">
			{posts.map((post) => (
				<li class="flex items-baseline justify-between gap-4 border-b border-rule py-3">
					<a href={`/writing/${post.id}`} class="text-sm">
						{post.data.title}
					</a>
					<time
						datetime={post.data.date.toISOString().slice(0, 10)}
						class="whitespace-nowrap font-mono text-xs text-faint"
					>
						{post.data.date.toISOString().slice(0, 10)}
					</time>
				</li>
			))}
		</ul>
	</section>

	<section class="mt-20">
		<h2 class="font-mono text-xs uppercase tracking-[0.2em] text-faint">Beeminder blog</h2>
		{beeminderPosts.map((post) => (
			<article class="mt-8 border-t border-rule pt-8">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="text-lg font-medium tracking-tight">
						<a href={post.url}>{post.title}</a>
					</h3>
					<span class="whitespace-nowrap font-mono text-xs text-faint">{post.date}</span>
				</div>
				<p class="mt-3 max-w-prose text-sm leading-relaxed text-mute">{post.blurb}</p>
			</article>
		))}
	</section>
</Layout>
