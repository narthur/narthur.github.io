---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import avatar from '../images/avatar.jpg';
import Layout from '../layouts/Layout.astro';

const positioning = 'Full-stack web developer building in React and TypeScript';

const contact = [
	{ name: 'GitHub', url: 'https://github.com/narthur' },
	{ name: 'LinkedIn', url: 'https://www.linkedin.com/in/nathanarthur/' },
	{ name: 'Email', url: 'mailto:nathan@pinepeakdigital.com' }
];

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const latest = posts[0];

const signposts = [
	{ name: 'Work', url: '/work', blurb: "Things I've built for employers, clients, and myself" },
	{
		name: 'Writing',
		url: '/writing',
		blurb: 'My mostly-weekly newsletter, plus a few assorted articles elsewhere'
	},
	{
		name: 'Uses',
		url: '/uses',
		blurb: 'The tools I rely on to stay productive and keep building'
	}
];
---

<!-- The description is `positioning`, so the tab, the search result, and the page can't drift apart.
     The page is deliberately one screen: /work carries the portfolio, /writing the newsletter.
     Every word here is Nathan's, which is why the page carries no AI notice: keep it that way, and
     see CLAUDE.md before adding copy. -->
<Layout title="Nathan Arthur" description={positioning} footer={false}>
	<div class="flex min-h-[70vh] flex-col justify-center">
		<Image
			src={avatar}
			alt="Pixel-art portrait of Nathan Arthur"
			width={124}
			densities={[1, 2]}
			class="mb-8 [image-rendering:pixelated]"
		/>

		<h1 class="text-4xl font-medium tracking-tight sm:text-5xl">Nathan Arthur</h1>

		<p class="mt-5 max-w-prose text-lg leading-relaxed text-mute sm:text-xl">{positioning}</p>

		<ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs uppercase tracking-widest">
			{contact.map((link) => (
				<li>
					<a href={link.url}>{link.name}</a>
				</li>
			))}
		</ul>

		<nav class="mt-11 grid gap-x-7 gap-y-5 border-t border-rule pt-6 sm:grid-cols-3">
			{signposts.map((signpost) => (
				<a href={signpost.url} class="block">
					<span class="text-[17px]">{signpost.name} &rarr;</span>
					<span class="mt-1.5 block max-w-[28ch] text-sm leading-relaxed text-faint">
						{signpost.blurb}
					</span>
				</a>
			))}
		</nav>

		<p class="mt-10 font-mono text-xs uppercase tracking-widest text-faint">
			Latest ·{' '}
			<a href={`/writing/${latest.id}`} class="text-mute">
				{latest.data.title}
			</a>
		</p>
	</div>
</Layout>
