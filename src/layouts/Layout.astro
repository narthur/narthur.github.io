---
import '../app.css';
import '@fontsource/instrument-sans/400.css'; // Regular
import '@fontsource/instrument-sans/500.css'; // Medium
import { TriangleAlert } from '@lucide/astro';
import AccentPicker from './AccentPicker.astro';

interface Props {
	title: string;
	description: string;
	/** Widen the column for pages whose charts need the room. */
	wide?: boolean;
	/** Set on any page whose prose Claude drafted, so the page says so. */
	ai?: boolean;
}

const { title, description, wide = false, ai = false } = Astro.props;

const footerLinks = [
	{ name: 'Uses', url: '/uses' },
	{ name: 'Substack', url: 'https://narthur.substack.com/' },
	{ name: 'Pine Peak Digital', url: 'https://pinepeakdigital.com/' },
	{ name: 'Stack Overflow', url: 'https://stackoverflow.com/users/937377/nathan-arthur' },
	{ name: 'Ko-fi', url: 'https://ko-fi.com/narthur' }
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="alternate" type="application/rss+xml" title="Narthur Online" href="/rss.xml" />
		<script
			is:inline
			src="https://challenges.cloudflare.com/turnstile/v0/api.js"
			async
			defer
		></script>
	</head>
	<body>
		<div
			class:list={[
				'mx-auto flex min-h-screen flex-col px-6 py-16 sm:px-8 sm:py-24',
				wide ? 'max-w-4xl' : 'max-w-2xl'
			]}
		>
			<main class="flex-grow">
				{ai && (
					<p class="mb-10 flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-faint">
						<TriangleAlert size={14} stroke-width={1.5} class="flex-none" aria-hidden="true" />
						Some of the writing on this page was drafted by Claude.
					</p>
				)}
				<slot />
			</main>

			<footer class="mt-24 border-t border-rule pt-8 text-sm text-mute">
				<p class="max-w-prose">
					I write a mostly-weekly newsletter. Subscribe for productivity tips and tools, AI news,
					and the random thoughts of a web developer with ADHD.
				</p>
				<!-- Handled by rss-to-email-worker; it replies with its own confirmation page. -->
				<form
					class="mt-4 flex flex-wrap gap-2"
					method="post"
					action="https://mail.nathanarthur.com/subscribe"
				>
					<label for="subscribe-email" class="sr-only">
						Email address
					</label>
					<input
						id="subscribe-email"
						type="email"
						name="email"
						required
						autocomplete="email"
						placeholder="you@example.com"
						class="min-w-0 flex-1 rounded border border-rule bg-transparent px-3 py-2 text-ink placeholder:text-faint"
					/>
					<button class="rounded bg-accent px-4 py-2 font-medium text-bg">Subscribe</button>
					<!-- action="subscribe" is checked by the Worker. -->
					<div
						class="cf-turnstile w-full"
						data-sitekey="0x4AAAAAAE8B6mITS1r7e6Zz"
						data-action="subscribe"
						data-appearance="interaction-only"
						data-theme="dark"
						data-size="flexible"
					></div>
				</form>

				<ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-faint">
					{footerLinks.map((link) => (
						<li>
							<a href={link.url}>{link.name}</a>
						</li>
					))}
				</ul>
			</footer>
		</div>

		{import.meta.env.DEV && <AccentPicker />}
	</body>
</html>

<style is:global>
	:root {
		--accent: #8ded51;
	}

	body {
		margin: 0;
		background: #0a0c10;
		color: #e8e9ec;
		font-family: 'Instrument Sans', system-ui, sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 0.25em;
	}

	/* The palette is fully custom, so don't rely on the browser's default focus ring
	   being legible against it. */
	a:focus-visible,
	button:focus-visible,
	input:focus-visible,
	summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 1px;
	}
</style>
