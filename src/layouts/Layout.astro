---
import '../app.css';
import '@fontsource/instrument-sans/400.css'; // Regular
import '@fontsource/instrument-sans/500.css'; // Medium
import { TriangleAlert } from '@lucide/astro';
import AccentPicker from './AccentPicker.astro';

interface Props {
	title: string;
	description: string;
	/** Widen the column for pages whose charts need the room. */
	wide?: boolean;
	/** Set on any page whose prose Claude drafted, so the page says so. */
	ai?: boolean;
	/** The home page stands on its own, so it drops the footer links. */
	footer?: boolean;
	/** The feed to advertise in <head>; /slop pages point readers at their own. */
	feed?: { title: string; href: string };
	/** A post's date. Marks the page as an article in link previews. */
	published?: Date;
	/** Who wrote the page, for LinkedIn's author field. Slop leaves it off, since AI writes it. */
	author?: string;
	/** The page's own Preview image (scripts/cards.mjs). Without one, the page shares the avatar. */
	preview?: { src: string; alt: string };
}

import { ACCENT } from '../theme';
import { POSITIONING } from '../site';

const {
	title,
	description,
	wide = false,
	ai = false,
	footer = true,
	feed = { title: 'Narthur Online', href: '/rss.xml' },
	published,
	author,
	preview
} = Astro.props;

// The build writes /work.html, but the site serves it as /work (see build.format in astro.config).
const url = new URL(
	Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1').replace(/\.html$/, ''),
	Astro.site
);
// 404.html is served at every missing URL, so it must not claim one of its own.
const isNotFound = url.pathname === '/404';

const footerLinks = [
	{ name: 'Uses', url: '/uses' },
	{ name: 'Pine Peak Digital', url: 'https://pinepeakdigital.com/' },
	{ name: 'Stack Overflow', url: 'https://stackoverflow.com/users/937377/nathan-arthur' },
	{ name: 'Ko-fi', url: 'https://ko-fi.com/narthur' }
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		{/* The one declaration of --accent, from src/theme.ts, so the Band render target can use the
		    same source. A <style> block cannot interpolate, hence set:html. */}
		<style is:inline set:html={`:root{--accent:${ACCENT}}`}></style>
		<title>{title}</title>
		<meta name="description" content={description} />
		{author && <meta name="author" content={author} />}
		{!isNotFound && <link rel="canonical" href={url} />}
		{/* Link previews in Discord, Slack, LinkedIn etc. Posts pass their own Preview image, shown
		    large; every other page shares the avatar 8x as a small square. */}
		<meta property="og:site_name" content={`Nathan Arthur · ${POSITIONING}`} />
		<meta property="og:type" content={published ? 'article' : 'website'} />
		{published && <meta property="article:published_time" content={published.toISOString()} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!isNotFound && <meta property="og:url" content={url} />}
		<meta property="og:image" content={new URL(preview?.src ?? '/og.png', Astro.site)} />
		<meta property="og:image:width" content={preview ? '1200' : '496'} />
		<meta property="og:image:height" content={preview ? '630' : '488'} />
		<meta property="og:image:alt" content={preview?.alt ?? 'Pixel-art portrait of Nathan Arthur'} />
		<meta name="twitter:card" content={preview ? 'summary_large_image' : 'summary'} />
		<link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
	</head>
	<body>
		<div
			class:list={[
				'mx-auto flex min-h-screen flex-col px-6 py-16 sm:px-8 sm:py-24',
				wide ? 'max-w-4xl' : 'max-w-2xl'
			]}
		>
			<main class="flex-grow">
				{ai && (
					<p class="mb-10 flex items-center justify-center gap-2 text-center font-mono text-[11px] uppercase tracking-widest text-faint">
						<TriangleAlert
							size={14}
							stroke-width={1.5}
							class="flex-none text-warn"
							aria-hidden="true"
						/>
						Some of the writing on this page was drafted by AI.
						<TriangleAlert
							size={14}
							stroke-width={1.5}
							class="flex-none text-warn"
							aria-hidden="true"
						/>
					</p>
				)}
				<slot />
			</main>

			{footer && (
				<footer class="mt-24 border-t border-rule pt-8 text-sm">
					<ul class="flex flex-wrap gap-x-5 gap-y-2 text-faint">
						{footerLinks.map((link) => (
							<li>
								<a href={link.url}>{link.name}</a>
							</li>
						))}
					</ul>
				</footer>
			)}
		</div>

		{import.meta.env.DEV && <AccentPicker />}
	</body>
</html>

<style is:global>
	body {
		margin: 0;
		background: #0a0c10;
		color: #e8e9ec;
		font-family: 'Instrument Sans', system-ui, sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 0.25em;
	}

	/* The palette is fully custom, so don't rely on the browser's default focus ring
	   being legible against it. */
	a:focus-visible,
	button:focus-visible,
	input:focus-visible,
	summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 1px;
	}
</style>
