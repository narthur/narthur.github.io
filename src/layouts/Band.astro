---
// A Band: the full-width generative strip behind a post's title, in place of a cover image.
//
// This component is the LIVE version, used while authoring. It runs the Sketch in the reader's
// browser, which costs more than a decorative strip is worth on a page meant for a 30-second
// skim — so the shipped page gets a pre-rendered image instead (see docs/adr/0001). This is what
// the dev picker drives, and what the build-time renderer screenshots.
//
// Positioned by the wrapper in `writing/[slug].astro`, which bottom-aligns the title over it.
import { P5_SRC, P5_INTEGRITY } from '../bands/cdn';
import { vectors } from '../bands';

export type Props = { sketch: string; seed: number };
const { sketch, seed } = Astro.props;

// A vector Sketch needs no p5, so the CDN tag below is skipped for one. That is not just tidiness:
// the tag is `is:inline` with an integrity hash, so it blocks render on a third-party request this
// page would otherwise make for nothing.
const isVector = sketch in vectors;
---

{/* Breaks out of the page column to full width: the column is `mx-auto`, so its centre is the
    page's centre and translating half its own width off that lands it flush to both edges.

    A raster Sketch appends a canvas here and that canvas supplies the width. A vector one has no
    canvas: it sets this element's own background to the SVG, tiled, the same way the shipped page
    draws it — one function, no second rasteriser to drift from.

    One deliberate exception: the accent. The build reads the ACCENT constant, this reads the live
    `--accent`, and AccentPicker sets that property on every dev page so a candidate colour can be
    tried against a real one. So while the picker holds a non-default accent, this Band is NOT the
    one that would ship — which is the point of the picker, not a fault in it. At the site's
    current accent the two agree. */}
<div
	id="band"
	aria-hidden="true"
	data-sketch={sketch}
	data-seed={seed}
	class:list={[
		'absolute bottom-0 left-1/2 z-0 h-60 -translate-x-1/2',
		isVector && 'w-screen bg-center bg-repeat-x'
	]}
></div>

{
	/* Dev-only, alongside the accent picker and for the same reason: a Seed is chosen by looking at
	   it against a real page. ↻ draws a new one; `copy` puts the frontmatter line on the clipboard,
	   because a mistyped Seed fails silently — you get a Band, just not the one you picked. */
	import.meta.env.DEV && (
		<aside
			id="band-picker"
			class="fixed bottom-4 left-4 z-50 rounded border border-rule bg-bg/95 p-3 font-mono text-xs text-mute shadow-lg backdrop-blur"
		>
			<div class="mb-2 text-faint">band · {sketch}</div>
			<div class="flex items-center gap-2">
				<button
					data-reseed
					aria-label="New seed"
					class="border border-rule px-2 py-1 hover:text-ink"
				>
					↻
				</button>
				<span class="text-ink" data-seed-label />
				<button data-copy class="border border-rule px-2 py-1 hover:text-ink">
					copy
				</button>
			</div>
		</aside>
	)
}

{
	/* Raster Sketches only. A vector Sketch draws with no p5 at all, and this tag is `is:inline`
	   with an integrity hash — so leaving it in would block render on a third-party request made
	   for nothing. */
	!isVector && (
		<script is:inline src={P5_SRC} integrity={P5_INTEGRITY} crossorigin="anonymous"></script>
	)
}

<script>
	import { mountBand } from '../bands/harness';
	import { sketches, vectors } from '../bands';
	import { toSvg } from '../bands/vector';
	import { ACCENT, BACKGROUND } from '../theme';

	// A module script is deferred, so the DOM is parsed and the inline p5 tag above has run. The
	// first version of this looked up its elements at parse time and found none.
	const host = document.getElementById('band');
	const name = host?.dataset.sketch ?? '';
	const sketch = host && sketches[name];
	const vector = host && vectors[name];

	// band-render.astro fails loudly on a name in neither registry, because a blank canvas there
	// would be captured and shipped. This is the page an author actually looks at while choosing a
	// Seed, and it used to do the opposite: no Band, no picker, no message, no clue. A typo in
	// `band.sketch` is the likely cause and nothing else would have said so.
	if (host && !sketch && !vector) {
		console.error(
			`band: no Sketch named ${JSON.stringify(name)}. Registered: ` +
				`${[...Object.keys(vectors), ...Object.keys(sketches)].sort().join(', ')}`
		);
	}

	if (host && (sketch || vector)) {
		const picker = document.getElementById('band-picker');
		const label = picker?.querySelector('[data-seed-label]');

		const announce = (seed: number) => {
			if (label) label.textContent = String(seed);
			host.dataset.seed = String(seed);
		};

		let render: (seed?: number) => void;

		if (vector) {
			// The same size scripts/bands.mjs renders, so dev and the shipped asset are the same
			// image rather than two renderings of one idea — a vector Band has no second rasteriser
			// to drift from. Tiling and height come from the element's classes, which are the ones
			// writing/[slug].astro gives the shipped background.
			//
			// The accent is the one input that can differ: the build uses the ACCENT constant and
			// this reads whatever `--accent` currently resolves to, which AccentPicker rewrites
			// live. That divergence is the picker working as intended; see the comment on the host
			// element above.
			render = (next?: number) => {
				const seed = next ?? Number(host.dataset.seed ?? 1);
				const accent =
					getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || ACCENT;
				const svg = toSvg(vector({ width: 3440, height: 240, seed, accent }));
				// encodeURIComponent, not base64: it keeps the markup readable in devtools, and a
				// `#` anywhere in the SVG — every colour here starts with one — would otherwise end
				// the URL early and leave the element blank.
				host.style.backgroundImage = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
				host.style.backgroundSize = 'auto 240px';
				host.style.backgroundColor = BACKGROUND;
				announce(seed);
			};
			render();
		} else {
			const band = mountBand(sketch!, {
				host,
				height: 240,
				seed: Number(host.dataset.seed ?? 1),
				// The build-time renderer appends ?w= so the capture is a known width rather than
				// whatever the headless viewport happens to be.
				width: Number(new URLSearchParams(location.search).get('w')) || undefined,
				onRender: announce
			});
			render = band.render;
		}

		picker?.querySelector('[data-reseed]')?.addEventListener('click', () => {
			render(Math.floor(Math.random() * 100000));
		});

		picker?.querySelector('[data-copy]')?.addEventListener('click', async (event) => {
			const line = `band: { sketch: '${host.dataset.sketch}', seed: ${host.dataset.seed} }`;
			const button = event.currentTarget as HTMLButtonElement;
			try {
				await navigator.clipboard.writeText(line);
				button.textContent = 'copied';
			} catch {
				// Clipboard access can be refused; show the line so it can still be read off screen.
				button.textContent = line;
			}
			setTimeout(() => (button.textContent = 'copy'), 2000);
		});
	}
</script>
