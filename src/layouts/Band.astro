---
// A generative band behind a post's title, in place of a cover image.
//
// The field is the argument: there are far more marks than anyone would look at, they all cost
// the same to draw, and a few happen to catch the light. It is redrawn on every load, so no two
// readers see the same arrangement — the one thing a flat cover image cannot do.
//
// EXPLORATORY. `MODE` below switches between three algorithms while we pick one; the losers come
// out, and so does p5 if the winner doesn't need it.
//
// Positioned by the wrapper in `writing/[slug].astro`, which bottom-aligns the title over it.
---

{/* Breaks out of the page column to full width: the column is `mx-auto`, so its centre is the
    page's centre and translating half its own width off that lands it flush to both edges. */}
<div id="band" aria-hidden="true" class="absolute bottom-0 left-1/2 h-60 -translate-x-1/2"></div>

{
	/* Dev-only mode picker, alongside the accent picker and for the same reason: the algorithm is
	   being chosen by looking at it against a real page. Goes when the exploration does. */
	import.meta.env.DEV && (
		<aside
			id="band-picker"
			class="fixed bottom-4 left-4 z-50 rounded border border-rule bg-bg/95 p-3 font-mono text-xs text-mute shadow-lg backdrop-blur"
		>
			<div class="mb-2 text-faint">band</div>
			<div class="flex gap-1">
				{['trails', 'forage', 'scatter', 'lattice', 'flow'].map((mode) => (
					<button data-mode={mode} class="border border-rule px-2 py-1 hover:text-ink">
						{mode}
					</button>
				))}
				<button data-redraw aria-label="Redraw" class="border border-rule px-2 py-1 hover:text-ink">
					↻
				</button>
			</div>
		</aside>
	)
}

<script
	is:inline
	src="https://cdn.jsdelivr.net/npm/p5@1.11.1/lib/p5.min.js"
	integrity="sha384-mNoDMsj3qyJxOkfse1kNjhDVbbYTNnpuSEL68aRVPnNERG3lHoGH+4FHEQSHJhYV"
	crossorigin="anonymous"
></script>

<script is:inline>
	const start = () => {
		// 'scatter' — even coverage, noise decides where the light falls
		// 'lattice' — a 4D grid under the same projection the post's own sketch uses
		// 'flow'    — short strokes combed by a noise field
		//
		// The dev picker and `?band=<mode>` both override this; the query form works against a
		// built preview too, where the picker is not rendered.
		const MODES = ['trails', 'forage', 'scatter', 'lattice', 'flow'];
		const DEFAULT_MODE = 'trails';
		const asked = new URLSearchParams(location.search).get('band');
		let MODE = MODES.includes(asked) ? asked : (sessionStorage.getItem('band') ?? DEFAULT_MODE);
		if (!MODES.includes(MODE)) MODE = DEFAULT_MODE;

		const HOST = document.getElementById('band');
		// This script is inline inside the band, which the heading follows, so the heading does
		// not exist yet at parse time — hence waiting for DOM ready below.
		const TEXT = document.querySelector('[data-band-text]');
		if (!HOST || !TEXT || typeof p5 === 'undefined') return;

		const HEIGHT = 240;
		const GUTTER = 16;
		const ACCENT =
			getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#8ded51';

		new p5((p) => {
			let W = document.documentElement.clientWidth;

			// Knock the field out from behind the title and date, measured rather than hardcoded so
			// it tracks the real text box however the title wraps.
			const clearText = () => {
				const box = TEXT.getBoundingClientRect();
				const band = HOST.getBoundingClientRect();
				p.drawingContext.clearRect(
					box.left - band.left - GUTTER,
					box.top - band.top - GUTTER,
					box.width + GUTTER * 2,
					box.height + GUTTER * 2
				);
			};

			// Even coverage without clumping: one mark per jittered grid cell, so nothing lands on
			// top of anything else and the field reads as uniform rather than accidentally clustered.
			// A low-frequency noise field then decides where the lit ones fall, so the light drifts
			// in regions instead of sprinkling at random.
			const scatter = () => {
				const STEP = 13;
				for (let gy = 0; gy < HEIGHT; gy += STEP) {
					for (let gx = 0; gx < W; gx += STEP) {
						const x = gx + p.random(STEP);
						const y = gy + p.random(STEP);
						const field = p.noise(x * 0.004, y * 0.004);
						const lit = field > 0.62 && p.random() < 0.22;
						p.noStroke();
						if (lit) {
							p.fill(p.color(ACCENT));
							p.drawingContext.globalAlpha = 0.45 + p.random(0.45);
							p.circle(x, y, 3.4);
						} else {
							p.fill(232, 233, 236);
							// Density of the dim field also rides the noise, so the band has drifts
							// and thin places rather than one flat tone.
							p.drawingContext.globalAlpha = 0.06 + field * 0.22;
							p.circle(x, y, 3.2);
						}
					}
				}
			};

			// The post's own sketch projects 4D -> 3D -> 2D; this runs a lattice through the same
			// pipeline at one frozen rotation, so the band is structurally the thing the post is about.
			const lattice = () => {
				const rot = (v, a, b, t) => {
					const c = Math.cos(t),
						s = Math.sin(t);
					const out = v.slice();
					out[a] = v[a] * c - v[b] * s;
					out[b] = v[a] * s + v[b] * c;
					return out;
				};
				const t = p.random(100);
				const N = 9;
				const S = Math.min(W, HEIGHT * 3) * 0.085;
				for (let i = 0; i < N; i++)
					for (let j = 0; j < N; j++)
						for (let k = 0; k < N; k++)
							for (let l = 0; l < N; l++) {
								let v = [i, j, k, l].map((n) => (n / (N - 1)) * 2 - 1);
								v = rot(v, 0, 3, t * 0.7);
								v = rot(v, 1, 3, t * 0.5);
								v = rot(v, 0, 1, t * 0.3);
								const w = v[3];
								v = rot(v, 1, 2, -0.9);
								const k4 = 3 / (3 - w);
								const [x, y, z] = v.map((n) => n * k4);
								const k3 = 4 / (4 - y);
								const sx = W / 2 + x * k3 * S;
								const sy = HEIGHT / 2 - z * k3 * S;
								if (sx < -10 || sx > W + 10 || sy < -10 || sy > HEIGHT + 10) continue;
								p.noStroke();
								// w decides the light: points that have swung toward the viewer in the
								// fourth dimension are the ones that catch it.
								if (w > 0.72) {
									p.fill(p.color(ACCENT));
									p.drawingContext.globalAlpha = 0.3 + w * 0.5;
								} else {
									p.fill(232, 233, 236);
									p.drawingContext.globalAlpha = 0.04 + k3 * k4 * 0.06;
								}
								p.circle(sx, sy, 1.2 + k3 * k4 * 1.1);
							}
			};

			// Stigmergy — how ants actually find paths. Each ant smells the pheromone just ahead of it
			// to the left, centre and right, turns toward the strongest, moves, and drops a little
			// where it lands. The field diffuses and evaporates every tick, so a route only survives
			// if ants keep choosing it. Nothing plans the network that emerges and no single ant can
			// perceive it — the post's question put as a mechanism rather than illustrated as a picture.
			//
			// Two buffers, because they want opposite things. `smell` is blurred and decaying: that is
			// what makes the ants steer, and blurring it is not optional. `ink` records where ants
			// actually walked and is never blurred, so the drawn trails stay sharp. Rendering the smell
			// field directly is what made the first version look like fog.
			const trails = () => {
				// Everything here runs in DEVICE pixels, not CSS pixels. putImageData writes straight
				// to the canvas backing store and ignores the transform p5 sets for pixel density, so
				// a CSS-sized buffer lands in the top-left quarter of a retina canvas. Scaling the
				// whole simulation keeps the trails one device pixel wide, which is the sharpness.
				const DPR = p.pixelDensity();
				const WD = Math.round(W * DPR);
				const HD = Math.round(HEIGHT * DPR);

				const CELL = 2 * DPR;
				const gw = Math.ceil(WD / CELL);
				const gh = Math.ceil(HD / CELL);
				const smell = new Float32Array(gw * gh);
				const next = new Float32Array(gw * gh);
				const ink = new Float32Array(WD * HD);

				const SENSE = 9 * DPR; // how far ahead an ant can smell; longer makes straighter routes
				const SPREAD = 0.45; // angle out to its left and right sensors
				const TURN = 0.55;
				const SPEED = 1.0 * DPR;
				const EVAP = 0.88; // lower evaporates faster, which sharpens trails into distinct routes
				const STEPS = 320; // long enough for routes to consolidate; at 80 it is still a search

				const sniff = (x, y) => {
					const gx = Math.floor(x / CELL);
					const gy = Math.floor(y / CELL);
					if (gx < 0 || gy < 0 || gx >= gw || gy >= gh) return -1;
					return smell[gy * gw + gx];
				};

				const ants = [];
				for (let i = 0; i < (WD * HD) / (90 * DPR * DPR); i++) {
					ants.push({ x: p.random(WD), y: p.random(HD), a: p.random(Math.PI * 2) });
				}

				for (let s = 0; s < STEPS; s++) {
					for (const ant of ants) {
						const c = Math.cos(ant.a);
						const si = Math.sin(ant.a);
						const ahead = sniff(ant.x + c * SENSE, ant.y + si * SENSE);
						const left = sniff(
							ant.x + Math.cos(ant.a - SPREAD) * SENSE,
							ant.y + Math.sin(ant.a - SPREAD) * SENSE
						);
						const right = sniff(
							ant.x + Math.cos(ant.a + SPREAD) * SENSE,
							ant.y + Math.sin(ant.a + SPREAD) * SENSE
						);
						if (ahead >= left && ahead >= right) {
							// already pointed at the strongest smell; hold the line
						} else if (left > right) ant.a -= TURN * p.random();
						else if (right > left) ant.a += TURN * p.random();
						else ant.a += (p.random() - 0.5) * TURN;

						ant.x += Math.cos(ant.a) * SPEED;
						ant.y += Math.sin(ant.a) * SPEED;
						// Wrap sideways so the band reads as a slice of something wider; bounce off the
						// top and bottom, which are real edges.
						if (ant.x < 0) ant.x += WD;
						if (ant.x >= WD) ant.x -= WD;
						if (ant.y < 0 || ant.y >= HD) {
							ant.a = -ant.a;
							ant.y = Math.min(Math.max(ant.y, 0), HD - 0.01);
						}

						const px = Math.floor(ant.x);
						const py = Math.floor(ant.y);
						smell[Math.floor(ant.y / CELL) * gw + Math.floor(ant.x / CELL)] += 1;
						// Steps are about a pixel apart, so stamping the one pixel draws a continuous
						// line without needing to interpolate between frames.
						ink[py * WD + px] += 1;
					}

					// Diffuse and evaporate. Weighted toward the centre rather than a flat box blur:
					// a flat average smears a trail outward as fast as the ants lay it down.
					for (let y = 0; y < gh; y++) {
						for (let x = 0; x < gw; x++) {
							const i = y * gw + x;
							let sum = smell[i] * 4;
							let n = 4;
							if (x > 0) {
								sum += smell[i - 1];
								n++;
							}
							if (x < gw - 1) {
								sum += smell[i + 1];
								n++;
							}
							if (y > 0) {
								sum += smell[i - gw];
								n++;
							}
							if (y < gh - 1) {
								sum += smell[i + gw];
								n++;
							}
							next[i] = (sum / n) * EVAP;
						}
					}
					smell.set(next);
				}

				// Scale to a high percentile rather than the maximum: one freak cell where ants piled up
				// would otherwise set the ceiling and push every real trail down into the dark. Taken
				// from a sample of the inked pixels — sorting all of them is a few million floats on a
				// retina canvas, and the percentile of a sample is the same number to the eye.
				const sample = [];
				for (let i = 0; i < ink.length; i += 11) if (ink[i]) sample.push(ink[i]);
				sample.sort((a, b) => a - b);
				const hi = sample[Math.floor(sample.length * 0.995)] || 1;

				// Parse the accent once; it is a hex string from the stylesheet.
				const ar = parseInt(ACCENT.slice(1, 3), 16);
				const ag = parseInt(ACCENT.slice(3, 5), 16);
				const ab = parseInt(ACCENT.slice(5, 7), 16);

				const img = p.drawingContext.createImageData(WD, HD);
				const px = img.data;
				for (let i = 0; i < ink.length; i++) {
					if (!ink[i]) continue;
					// Square-root curve: compresses the top so the busiest routes do not blow out, and
					// lifts the faint ones so single passes still register.
					const v = Math.min(1, Math.sqrt(ink[i] / hi));
					// The busiest routes take the accent; everything else stays off-white.
					const t = Math.max(0, (v - 0.45) / 0.55);
					const o = i * 4;
					px[o] = 232 + (ar - 232) * t;
					px[o + 1] = 233 + (ag - 233) * t;
					px[o + 2] = 236 + (ab - 236) * t;
					px[o + 3] = Math.min(255, v * 255);
				}
				p.drawingContext.putImageData(img, 0, 0);
			};

			// Path integration — the other half of how ants navigate. A desert ant forages on a long
			// wandering search, tracking its heading and distance the whole way, and then walks a
			// straight line home: a vector it computed without ever being able to see the route. The
			// dim tangle is what it actually walked; the lit chord is what it worked out.
			const forage = () => {
				const nests = [];
				const count = Math.max(2, Math.round(W / 420));
				for (let i = 0; i < count; i++) {
					nests.push({
						x: (W * (i + 0.5)) / count + p.random(-60, 60),
						y: HEIGHT * p.random(0.35, 0.72)
					});
				}

				for (const nest of nests) {
					for (let i = 0; i < 110; i++) {
						let x = nest.x;
						let y = nest.y;
						let a = p.random(Math.PI * 2);
						const steps = 35 + p.random(55);

						p.noFill();
						p.stroke(232, 233, 236);
						p.drawingContext.globalAlpha = 0.07;
						p.strokeWeight(0.8);
						p.beginShape();
						for (let s = 0; s < steps; s++) {
							// A correlated random walk: each step turns a little off the last, which is
							// what a searching ant's track actually looks like.
							a += (p.random() - 0.5) * 0.75;
							x += Math.cos(a) * 2.4;
							y += Math.sin(a) * 2.4;
							p.vertex(x, y);
						}
						p.endShape();

						p.stroke(p.color(ACCENT));
						p.drawingContext.globalAlpha = 0.16;
						p.strokeWeight(0.7);
						p.line(x, y, nest.x, nest.y);
					}
				}
			};

			// Short strokes combed by a noise field: the same mark repeated everywhere, but the field
			// gives the repetition a grain, so it reads as weather rather than as static.
			const flow = () => {
				const SEEDS = Math.round((W * HEIGHT) / 900);
				for (let i = 0; i < SEEDS; i++) {
					let x = p.random(W);
					let y = p.random(HEIGHT);
					const lit = p.random() < 0.05;
					p.stroke(lit ? p.color(ACCENT) : p.color(232, 233, 236));
					p.drawingContext.globalAlpha = lit ? 0.4 + p.random(0.35) : 0.07 + p.random(0.1);
					p.strokeWeight(lit ? 1.5 : 1.1);
					for (let step = 0; step < 14; step++) {
						const a = p.noise(x * 0.0035, y * 0.0035) * Math.PI * 3;
						const nx = x + Math.cos(a) * 3.2;
						const ny = y + Math.sin(a) * 3.2;
						p.line(x, y, nx, ny);
						x = nx;
						y = ny;
					}
				}
			};

			const render = () => {
				W = document.documentElement.clientWidth;
				p.resizeCanvas(W, HEIGHT);
				p.clear();
				p.noiseSeed(Math.random() * 10000);
				p.randomSeed(Math.random() * 10000);
				({ trails, forage, scatter, lattice, flow })[MODE]();
				p.drawingContext.globalAlpha = 1;
				clearText();
			};

			p.setup = () => {
				p.createCanvas(W, HEIGHT).parent(HOST);
				p.noLoop();
				render();
				// Web fonts land after first paint and reflow the heading, moving the box the knock-out
				// is cut from; redraw once they are ready.
				document.fonts?.ready.then(render);
			};

			let settle;
			p.windowResized = () => {
				clearTimeout(settle);
				settle = setTimeout(render, 150);
			};

			// Wire the dev picker, if it rendered. Every navigation is a full page load, so the
			// choice is carried in sessionStorage the way the accent picker carries its colour.
			const picker = document.getElementById('band-picker');
			if (picker) {
				const mark = () => {
					for (const b of picker.querySelectorAll('[data-mode]')) {
						const on = b.dataset.mode === MODE;
						b.classList.toggle('border-ink', on);
						b.classList.toggle('text-ink', on);
						b.classList.toggle('border-rule', !on);
					}
				};
				for (const b of picker.querySelectorAll('[data-mode]')) {
					b.addEventListener('click', () => {
						MODE = b.dataset.mode;
						sessionStorage.setItem('band', MODE);
						mark();
						render();
					});
				}
				picker.querySelector('[data-redraw]').addEventListener('click', render);
				mark();
			}
		});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', start);
	} else {
		start();
	}
</script>
