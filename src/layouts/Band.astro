---
// A Band: the full-width generative strip behind a post's title, in place of a cover image.
//
// This component is the LIVE version, used while authoring. It runs the Sketch in the reader's
// browser, which costs more than a decorative strip is worth on a page meant for a 30-second
// skim — so the shipped page gets a pre-rendered image instead (see docs/adr/0001). This is what
// the dev picker drives, and what the build-time renderer screenshots.
//
// Positioned by the wrapper in `writing/[slug].astro`, which bottom-aligns the title over it.
import { P5_SRC, P5_INTEGRITY } from '../bands/cdn';

export type Props = { sketch: string; seed: number };
const { sketch, seed } = Astro.props;
---

{/* Breaks out of the page column to full width: the column is `mx-auto`, so its centre is the
    page's centre and translating half its own width off that lands it flush to both edges. */}
<div
	id="band"
	aria-hidden="true"
	data-sketch={sketch}
	data-seed={seed}
	class="absolute bottom-0 left-1/2 z-0 h-60 -translate-x-1/2"
></div>

{
	/* Dev-only, alongside the accent picker and for the same reason: a Seed is chosen by looking at
	   it against a real page. ↻ draws a new one; `copy` puts the frontmatter line on the clipboard,
	   because a mistyped Seed fails silently — you get a Band, just not the one you picked. */
	import.meta.env.DEV && (
		<aside
			id="band-picker"
			class="fixed bottom-4 left-4 z-50 rounded border border-rule bg-bg/95 p-3 font-mono text-xs text-mute shadow-lg backdrop-blur"
		>
			<div class="mb-2 text-faint">band · {sketch}</div>
			<div class="flex items-center gap-2">
				<button
					data-reseed
					aria-label="New seed"
					class="border border-rule px-2 py-1 hover:text-ink"
				>
					↻
				</button>
				<span class="text-ink" data-seed-label />
				<button data-copy class="border border-rule px-2 py-1 hover:text-ink">
					copy
				</button>
			</div>
		</aside>
	)
}

<script is:inline src={P5_SRC} integrity={P5_INTEGRITY} crossorigin="anonymous"></script>

<script>
	import { mountBand } from '../bands/harness';
	import { sketches } from '../bands';

	// A module script is deferred, so the DOM is parsed and the inline p5 tag above has run. The
	// first version of this looked up its elements at parse time and found none.
	const host = document.getElementById('band');
	const sketch = host && sketches[host.dataset.sketch ?? ''];

	if (host && sketch) {
		const picker = document.getElementById('band-picker');
		const label = picker?.querySelector('[data-seed-label]');

		const band = mountBand(sketch, {
			host,
			height: 240,
			seed: Number(host.dataset.seed ?? 1),
			// The build-time renderer appends ?w= so the capture is a known width rather than
			// whatever the headless viewport happens to be.
			width: Number(new URLSearchParams(location.search).get('w')) || undefined,
			onRender: (seed) => {
				if (label) label.textContent = String(seed);
				host.dataset.seed = String(seed);
			}
		});

		picker?.querySelector('[data-reseed]')?.addEventListener('click', () => {
			band.render(Math.floor(Math.random() * 100000));
		});

		picker?.querySelector('[data-copy]')?.addEventListener('click', async (event) => {
			const line = `band: { sketch: '${host.dataset.sketch}', seed: ${host.dataset.seed} }`;
			const button = event.currentTarget as HTMLButtonElement;
			try {
				await navigator.clipboard.writeText(line);
				button.textContent = 'copied';
			} catch {
				// Clipboard access can be refused; show the line so it can still be read off screen.
				button.textContent = line;
			}
			setTimeout(() => (button.textContent = 'copy'), 2000);
		});
	}
</script>
