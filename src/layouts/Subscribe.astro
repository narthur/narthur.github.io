<div class="text-sm text-mute">
	<p class="max-w-prose">
		I write a mostly-weekly newsletter. Subscribe for productivity tips and tools, AI news, and the
		random thoughts of a web developer with ADHD.
	</p>
	<!-- Handled by rss-to-email-worker; it replies with its own confirmation page. -->
	<form
		class="mt-4 flex flex-wrap gap-2"
		method="post"
		action="https://mail.nathanarthur.com/subscribe"
	>
		<label for="subscribe-email" class="sr-only">
			Email address
		</label>
		<input
			id="subscribe-email"
			type="email"
			name="email"
			required
			autocomplete="email"
			placeholder="you@example.com"
			class="min-w-0 flex-1 rounded border border-rule bg-transparent px-3 py-2 text-ink placeholder:text-faint"
		/>
		<button class="rounded bg-accent px-4 py-2 font-medium text-bg">Subscribe</button>
		<!-- action="subscribe" is checked by the Worker. -->
		<div
			class="cf-turnstile w-full"
			data-sitekey="0x4AAAAAAE8B6mITS1r7e6Zz"
			data-action="subscribe"
			data-appearance="interaction-only"
			data-theme="dark"
			data-size="flexible"
		></div>
	</form>
</div>
<!-- ponytail: one form per page. A second would duplicate the subscribe-email id and load this script twice; give it an id prop and a deduplicated loader if that is ever needed. -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
